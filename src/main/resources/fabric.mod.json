{
	"schemaVersion": 1,
	"id": "jumpresetping",
	"version": "${version}",
	"name": "jump resetpingmod",
	"description": "PvP mod that plays a ping sound when you successfully perform a Jump Reset, and predicts incoming hits based on opponent arm swing animations.",
	"authors": [
		"Mac đ"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/jumpresetping/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"jumpresetping.mixins.json",
		{
			"config": "jumpresetping.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "*",
		"java": ">=21",
		"fabric-api": "*"
	}
}